# OpenRouter — backend only. Never put this key in a VITE_ variable.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Must match the vector column and the dimensions requested from the embedding model.
EMBEDDING_DIMENSIONS=1536

# Docker Compose publishes pgvector on 5433 so it does not collide with a
# Postgres already listening on 5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/casava_chatbot

# Backend
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development
APP_URL=http://localhost:5173

# Retrieval
KNOWLEDGE_DIR=knowledge/reviewed
RETRIEVAL_LIMIT=4
RETRIEVAL_MAX_DISTANCE=0.72
HISTORY_LIMIT=12
